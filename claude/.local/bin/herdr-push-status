#!/bin/zsh
# Runs on iris from a Claude Code hook. Pushes this worktree's claude status to
# its herdr tab on the Mac. No-op unless inside a herdr keeper (HERDR_TAB set by
# iris-agent = the branch/tab label). Usage: herdr-push-status <needs-input|done|working>
[ -n "${HERDR_TAB:-}" ] || exit 0
ssh -o BatchMode=yes -o ConnectTimeout=4 mac "~/.local/bin/herdr-tab-status '${HERDR_TAB}' '${1:-}'" >/dev/null 2>&1 || true
exit 0
