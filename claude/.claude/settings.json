{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "100000"
  },
  "permissions": {
    "allow": [
      "Edit",
      "Bash(bun:*)",
      "Bash(npm:*)",
      "Bash(pnpm:*)",
      "Bash(yarn:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git diff-tree:*)",
      "Bash(git ls-tree:*)",
      "Bash(git rev-parse:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git checkout:*)",
      "Bash(git branch:*)",
      "Bash(git stash:*)",
      "Bash(git worktree:*)",
      "Bash(git fetch:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git clean:*)",
      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(cat:*)",
      "Bash(wc:*)",
      "Bash(which:*)",
      "Bash(where:*)",
      "Bash(echo:*)",
      "Bash(diff:*)",
      "Bash(file:*)",
      "Bash(find:*)",
      "Bash(tree:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(swift:*)",
      "Bash(xcodebuild:*)",
      "Bash(agvtool:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh repo view:*)",
      "Bash(mix test:*)",
      "Bash(mix compile:*)",
      "Bash(mix check:*)",
      "Bash(mix format:*)",
      "Bash(mix run:*)",
      "WebSearch",
      "mcp__context7__resolve-library-id",
      "mcp__context7__get-library-docs",
      "mcp__plugin_context7_context7__resolve-library-id",
      "mcp__plugin_context7_context7__query-docs",
      "mcp__plugin_linear_linear__get_project",
      "Bash(gcloud functions list:*)",
      "Bash(gcloud logging read:*)",
      "Bash(docker:*)",
      "Bash(npx:*)",
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(cd:*)",
      "Bash(pwd:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Read(~/.zshrc)",
      "mcp__linear__list_comments",
      "mcp__linear__create_comment",
      "mcp__linear__get_issue",
      "mcp__linear__get_issue_git_branch_name",
      "mcp__linear__list_issues",
      "mcp__linear__list_issue_statuses",
      "mcp__linear__get_issue_status",
      "mcp__linear__list_my_issues",
      "mcp__linear__list_issue_labels",
      "mcp__linear__list_projects",
      "mcp__linear__get_project",
      "mcp__linear__get_team",
      "mcp__linear__list_users",
      "mcp__linear__get_user",
      "mcp__linear__search_documentation",
      "mcp__postgres__query"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(./secrets/**)",
      "Bash(rm:*)"
    ],
    "defaultMode": "default"
  },
  "model": "claude-fable-5[1m]",
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/claude-notify '✅ Claude Finished' 'white_check_mark' \"Task complete — $(basename $(pwd))\""
          },
          {
            "type": "command",
            "command": "$HOME/.local/bin/herdr-push-status done"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "MSG=$(echo \"$CLAUDE_NOTIFICATION_MESSAGE\" | head -c 200); $HOME/.local/bin/claude-notify '🔔 Claude Needs Input' 'bell' \"${MSG:-(no message)} — $(basename $(pwd))\""
          },
          {
            "type": "command",
            "command": "$HOME/.local/bin/herdr-push-status needs-input"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/herdr-push-status working"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.local/bin/ccstatusline",
    "padding": 0,
    "refreshInterval": 60
  },
  "enabledPlugins": {
    "claude-md-management@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "linear@claude-plugins-official": false,
    "ralph-loop@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "worktrunk@worktrunk": true
  },
  "extraKnownMarketplaces": {
    "worktrunk": {
      "source": {
        "source": "github",
        "repo": "max-sixty/worktrunk"
      }
    }
  },
  "effortLevel": "medium",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "CLAUDE_CODE_SUBAGENT_MODEL": "claude-sonnet-4-6"
}
