.worktrees
opencode.json
# ignore xcuser state
*.xcuserstate
*.xcuserdatad
*.DS_Store
*xcuserdata
*.xcshareddata
buildServer.json
*.obsidian
.venv
.env
.nvim/xcodebuild

# tmux plugins (installed by TPM at runtime)
terminal/.config/tmux/plugins/

# Hammerspoon build artifacts
mac/.hammerspoon/hs._asm.undocumented.spaces/obj_arm64/
mac/.hammerspoon/hs._asm.undocumented.spaces
mac/.hammerspoon/hs/

# Secrets — Linux reads ~/.secrets, macOS uses the Keychain
.secrets
terminal/.secrets

# Machine-local shell config. Deliberately per-machine and untracked;
# ~/.zshrc sources it if present.
.zshrc.local
terminal/.zshrc.local

# SSH — never commit private keys, or host entries with real addresses
ssh/.ssh/id_*
ssh/.ssh/*.pem
ssh/.ssh/known_hosts*
ssh/.ssh/config.local
.ssh/config.local

# ClipSync device registration. Contains a per-device auth token AND a device
# identity — must never be shared between machines. `clipsyncd login` recreates
# it on each new machine.
clipsync/.config/clipsync/daemon.json

# Atuin — the receipt is machine-local registration state, not config
terminal/.config/atuin/atuin-receipt.json

# Claude Code — only settings.json and CLAUDE.md are tracked
claude/.claude/history.jsonl
claude/.claude/sessions/
claude/.claude/cache/
claude/.claude/backups/
claude/.claude/debug/
claude/.claude/projects/
claude/.claude/todos/
claude/.claude/stats-cache.json
claude/.claude/mcp-needs-auth-cache.json
claude/.claude/paste-cache/
claude/.claude/shell-snapshots/
claude/.claude/usage-data/
claude/.claude/statsig/
claude/.claude/telemetry/
claude/.claude/ide/
claude/.claude/chrome/
claude/.claude/agents/
claude/.claude/tasks/
claude/.claude/teams/
claude/.claude/plans/
claude/.claude/file-history/
claude/.claude/commands/
claude/.claude/plugins/
claude/.claude/session-env/

# Home Assistant instance data — credentials, device tokens, state database
services/homeassistant/config/*
# Automations are real config with no secrets in them — worth versioning.
!services/homeassistant/config/automations.yaml
# Likewise configuration.yaml: HomeKit bridges, template entities and the http
# proxy settings. Credentials live in .storage and secrets.yaml, not here, and
# without this the entire hand-written config is untracked on one disk.
!services/homeassistant/config/configuration.yaml

# Frigate — camera credentials, recordings, and runtime database
services/frigate/.env
services/frigate/media/
services/frigate/config/*.db
services/frigate/config/*.db-*
services/frigate/config/model_cache/
services/frigate/config/backup_config.yaml
# Frigate runtime state written beside the config
services/frigate/config/.exports
services/frigate/config/.jwt_secret
services/frigate/config/.search_stats.json
services/frigate/config/.timeline
services/frigate/config/.vacuum
# go2rtc HomeKit accessories: per-device PINs and controller pairing keys.
# Machine-local pairing state, and re-pairing is required if it is lost.
services/frigate/config/go2rtc_homekit.yml

# Matter Hub — HA access token, and the Matter fabric state (bridge identity
# plus every controller pairing). Machine-specific; back data/ up separately.
services/matterhub/.env
services/matterhub/data/

# Mosquitto — broker credentials and runtime state
services/mosquitto/config/passwd
services/mosquitto/data/
services/mosquitto/log/
