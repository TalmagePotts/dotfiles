# Copy to .env in this directory and fill in. .env is gitignored — this repo is public.
#
#   cp .env.example .env && $EDITOR .env

# Camera's IP address on your LAN. Reserve it in your router's DHCP settings
# first, or it will change on reboot and Frigate will lose the camera.
FRIGATE_CAM_HOST=192.168.0.XXX

# Reolink login. "admin" unless you made another user in the Reolink app.
FRIGATE_CAM_USER=admin
FRIGATE_CAM_PASSWORD=

# Frigate's own web UI password (user: admin). Pick something; leaving this
# blank means Frigate generates one and prints it to the log on first start.
FRIGATE_ADMIN_PASSWORD=
