# Host entries with real addresses live in ~/.ssh/config.local, which is
# untracked — this repo is public and tailnet addresses do not belong in it.
# Include must come first: for any given keyword, ssh honours the value it
# sees FIRST, so entries in config.local win over anything below.
Include ~/.ssh/config.local

Host *
    SetEnv TERM=xterm-256color

Host Jarvis
    User teapot

Host jarvis
    User teapot

Host iris
    User teapot

Host atlas
    User teapot

Host vigil
    User teapot
