# Copy to ~/.secrets and fill in. Never commit the real file — this repo is public.
#
#   cp .secrets.example ~/.secrets && chmod 600 ~/.secrets && $EDITOR ~/.secrets
#
# Sourced by ~/.zshrc on Linux (macOS reads the Keychain instead) and by
# ~/.local/bin/claude-notify, which runs from Claude Code hooks in a
# non-interactive shell that never sees your .zshrc.

# ntfy.sh topic for Claude Code notifications.
# NOTE: an ntfy topic name is an unauthenticated capability — anyone who knows
# it can subscribe to every notification you receive and post to it. Treat it
# like a password, and pick a long random name.
export CLAUDE_NTFY_TOPIC=""

# ClipSync server (tailnet URL, e.g. https://<host>.<tailnet>.ts.net/clipsync)
export CLIPSYNC_SERVER=""

# Project database / API credentials
export DATABASE_URL=""
export SUPABASE_ACCESS_TOKEN=""
