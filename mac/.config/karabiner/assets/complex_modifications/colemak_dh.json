{
  "title": "Colemak-DH with QWERTY Toggle (Right Option + Space)",
  "rules": [
    {
      "description": "Toggle Colemak-DH (Right Option + Space to switch)",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "spacebar",
            "modifiers": { "mandatory": ["right_option"] }
          },
          "to": [
            {
              "set_variable": {
                "name": "colemak_dh_enabled",
                "value": 0
              }
            }
          ],
          "conditions": [
            {
              "type": "variable_if",
              "name": "colemak_dh_enabled",
              "value": 1
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "spacebar",
            "modifiers": { "mandatory": ["right_option"] }
          },
          "to": [
            {
              "set_variable": {
                "name": "colemak_dh_enabled",
                "value": 1
              }
            }
          ],
          "conditions": [
            {
              "type": "variable_unless",
              "name": "colemak_dh_enabled",
              "value": 1
            }
          ]
        }
      ]
    },
    {
      "description": "Colemak-DH Layout (active when colemak_dh_enabled = 1)",
      "manipulators": [
        {
          "type": "basic",
          "from": { "key_code": "q" },
          "to": [{ "key_code": "q" }],
          "conditions": [{ "type": "variable_if", "name": "colemak_dh_enabled", "value": 1 }]
        },
        {
          "type": "basic",
          "from": { "key_code": "w" },
          "to": [{ "key_code": "w" }],
          "conditions": [{ "type": "variable_if", "name": "colemak_dh_enabled", "value": 1 }]
        },
        {
          "type": "basic",
          "from": { "key_code": "e" },
          "to": [{ "key_code": "f" }],
          "conditions": [{ "type": "variable_if", "name": "colemak_dh_enabled", "value": 1 }]
        },
        {
          "type": "basic",
          "from": { "key_code": "r" },
          "to": [{ "key_code": "p" }],
          "conditions": [{ "type": "variable_if", "name": "colemak_dh_enabled", "value": 1 }]
        },
